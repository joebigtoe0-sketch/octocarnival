# ── Backend env vars ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Database (auto-injected by Railway Postgres plugin in production)
DATABASE_URL=postgresql://user:password@localhost:5432/scraprats

# Redis (auto-injected by Railway Redis plugin in production)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace-with-long-random-64-char-random-string
JWT_EXPIRES_IN=7d

# Google OAuth — only the Client ID is needed (backend verifies ID tokens)
GOOGLE_CLIENT_ID=

# Frontend URL for CORS (set to Railway frontend URL in production)
FRONTEND_URL=http://localhost:5173

# ── Frontend env vars (VITE_* are baked into the build) ─────────────────────
# Set these in the Railway frontend service's env vars before deploying.
# VITE_API_URL=https://your-backend.railway.app
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
