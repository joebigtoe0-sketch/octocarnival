# ── Backend env vars ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Database (auto-injected by Railway Postgres plugin in production)
DATABASE_URL=postgresql://user:password@localhost:5432/scraprats

# Redis (auto-injected by Railway Redis plugin in production)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace-with-long-random-64-char-random-string
JWT_EXPIRES_IN=7d

# Google OAuth — only the Client ID is needed (backend verifies ID tokens)
GOOGLE_CLIENT_ID=

# Frontend URL for CORS (set to Railway frontend URL in production)
FRONTEND_URL=http://localhost:5173

# Solana / NFT minting (backend) — Helius URL goes HERE only, not in VITE_* vars
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SCRAP_MINT_ADDRESS=6wDhSCLLZRQMJQwafEtoyBz4u9tQnYDwJMs98cYHpump
METAPLEX_COLLECTION_ADDRESS=
MINT_AUTHORITY_SECRET=
MINT_BURN_AMOUNT=10000
PUBLIC_BACKEND_URL=http://localhost:3001
# IPFS_TOKEN=   # optional NFT.Storage bearer token

# ── Frontend env vars (VITE_* are baked into the build) ─────────────────────
# Set these in the Railway frontend service's env vars before deploying.
# VITE_API_URL=https://your-backend.railway.app
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
# VITE_SOLANA_NETWORK=mainnet-beta
# VITE_SCRAP_MINT_ADDRESS=6wDhSCLLZRQMJQwafEtoyBz4u9tQnYDwJMs98cYHpump
# Wallet RPC is proxied via backend (/api/solana/rpc) — do not set VITE_SOLANA_RPC_URL
# Public site URL — required for Twitter/Telegram link previews (og:image absolute URL)
# VITE_SITE_URL=https://your-frontend.railway.app
